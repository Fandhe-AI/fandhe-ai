+/// GELU 近似活性化関数（tanh 近似）:
+/// `0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))`。
+///
+/// S2（TASK-4.2a 評価用データセット・イシュー #109）の安全な機能追加
+/// 題材として新規実装した活性化関数。既存 API（relu/sigmoid/leaky_relu）
+/// は一切変更しない。
+pub fn gelu_approx<'t>(tape: &'t Tape, x: &Var<'t>) -> Var<'t> {
+    let x2 = x.mul(x).expect("gelu_approx: x と x は同一 shape");
+    let x3 = x2.mul(x).expect("gelu_approx: x2 と x は同一 shape");
+    let coeff = constant(tape, 0.044715);
+    let cubic_term = x3
+        .mul(&coeff)
+        .expect("gelu_approx: shape [1] は常に broadcast 可能");
+    let inner_sum = x
+        .add(&cubic_term)
+        .expect("gelu_approx: x と cubic_term は同一 shape");
+    let sqrt_2_over_pi = constant(tape, (2.0_f64 / std::f64::consts::PI).sqrt() as f32);
+    let scaled = inner_sum
+        .mul(&sqrt_2_over_pi)
+        .expect("gelu_approx: shape [1] は常に broadcast 可能");
+    let tanh_term = scaled.tanh();
+    let one = constant(tape, 1.0);
+    let tanh_plus_one = tanh_term
+        .add(&one)
+        .expect("gelu_approx: shape [1] は常に broadcast 可能");
+    let half = constant(tape, 0.5);
+    let x_half = x
+        .mul(&half)
+        .expect("gelu_approx: shape [1] は常に broadcast 可能");
+    x_half
+        .mul(&tanh_plus_one)
+        .expect("gelu_approx: x_half と tanh_plus_one は同一 shape")
+}
