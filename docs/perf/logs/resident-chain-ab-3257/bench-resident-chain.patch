+/// `train --mode chain`（#3257 計測専用。参考系列）。`run_train_reuse` と同じ構造・同じ
+/// init／warmup／計測回数で、窓の中だけを常駐チェーン（`Sequential::train_step_resident`
+/// ＋ `ResidentLoss::read`）に置き換える。`x`・`y` は窓の外（init）で 1 回だけ
+/// `Tape::upload_resident` する（PyTorch 側 `bench_py.py` が X／Y を窓の外で 1 回だけ
+/// 置くのと対称）。`init_s` は upload_resident の時間を含む。公開面からはチェーンが
+/// Tape 経路へフォールバックしたかを観測できない（RULE.txt [限界]）。
+fn run_train_chain(cli: &Cli) -> Result<(), Box<dyn std::error::Error>> {
+    let model = build_model()?;
+    let (x_data, y_data) = mlp_data()?;
+
+    let init_start = Instant::now();
+    let init_tape = make_tape(&cli.device)?;
+    let mut store = model.init_device_param_store(&init_tape)?;
+    let rx = init_tape.upload_resident(&store, &x_data)?;
+    let ry = init_tape.upload_resident(&store, &y_data)?;
+    let _ = init_tape.sync_device_param_store_to_host(&store)?;
+    drop(init_tape);
+    let init_s = init_start.elapsed().as_secs_f64();
+
+    let config = SgdConfig::new(LR);
+    let mut durations = Vec::with_capacity(TRAIN_STEPS);
+    let mut last_loss = 0.0f32;
+    for _ in 0..TRAIN_STEPS {
+        let start = Instant::now();
+        let resident_loss = model.train_step_resident(&mut store, &rx, &ry, &config)?;
+        last_loss = resident_loss.read(&mut store)?;
+        durations.push(start.elapsed());
+    }
+    if !last_loss.is_finite() {
+        return Err(format!("MEASURE_ERROR: final loss not finite: {last_loss}").into());
+    }
+
+    let final_tape = make_tape(&cli.device)?;
+    let synced = final_tape.sync_device_param_store_to_host(&store)?;
+    let expected_len = model.trainable_parameters().len();
+    if synced.len() != expected_len {
+        return Err(format!(
+            "MEASURE_ERROR: sync_device_param_store_to_host returned {} tensors, expected {expected_len}",
+            synced.len()
+        )
+        .into());
+    }
+    for t in &synced {
+        let slice = t
+            .contiguous()
+            .as_slice()
+            .ok_or("synced param as_slice() returned None")?
+            .to_vec();
+        if slice.iter().any(|v| !v.is_finite()) {
+            return Err("MEASURE_ERROR: synced parameter contains non-finite element".into());
+        }
+    }
+    emit_param_digest("chain", &cli.device, &synced)?;
+
+    let measured = &durations[TRAIN_WARMUP..];
+    let st = stats(measured)?;
+    Record {
+        framework: FRAMEWORK,
+        framework_version: VERSION,
+        task: "train",
+        device: &cli.device,
+        size: BATCH,
+        stats: st,
+        gflops: None,
+        throughput_per_s: None,
+        checksum: last_loss as f64,
+        warmup: TRAIN_WARMUP,
+        iters: measured.len(),
+        mode: "chain",
+        init_s: Some(init_s),
+        parity: None,
+        tf32: false,
+        managed: cli.managed,
+        device_checksum: false,
+        graph: cli.graph.as_deref(),
+        readout: None,
+        metal_split_k: cli.metal_split_k.as_deref(),
+        pinned_h2d: cli.pinned_h2d,
+        #[cfg(feature = "graph-step")]
+        graph_stats: cli.graph.as_ref().map(|_| current_graph_stats()),
+        #[cfg(not(feature = "graph-step"))]
+        graph_stats: None,
+    }
+    .emit(&cli.out)?;
+    Ok(())
+}
