+/// #3257 計測専用: 更新後パラメータの bit 列 FNV-1a 64 を stderr へ 1 行出す。
+/// `BENCH_PARAM_DIGEST=1` のときだけ動作し、計測窓の外（終端同期後）から呼ぶ。
+/// reuse（現行経路）と chain（常駐チェーン）の更新結果が bit 一致することの確認用。
+fn emit_param_digest(
+    mode: &str,
+    device: &str,
+    params: &[impl std::borrow::Borrow<Tensor<f32>>],
+) -> Result<(), Box<dyn std::error::Error>> {
+    if std::env::var("BENCH_PARAM_DIGEST").as_deref() != Ok("1") {
+        return Ok(());
+    }
+    let mut h: u64 = 0xcbf29ce484222325;
+    let mut n_elems = 0usize;
+    for t in params {
+        let c = t.borrow().contiguous();
+        let sl = c.as_slice().ok_or("digest: param as_slice None")?;
+        for v in sl {
+            for b in v.to_bits().to_le_bytes() {
+                h ^= u64::from(b);
+                h = h.wrapping_mul(0x100000001b3);
+            }
+        }
+        n_elems += sl.len();
+    }
+    eprintln!(
+        "PARAM_DIGEST task=train mode={mode} device={device} n_tensors={} n_elems={n_elems} fnv1a64=0x{h:016x}",
+        params.len()
+    );
+    Ok(())
+}
