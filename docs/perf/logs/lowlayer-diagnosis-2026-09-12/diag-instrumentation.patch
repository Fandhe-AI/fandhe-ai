+        let data: Vec<f32> = (0..ROWS * COLS).map(|i| (i as f32) * 0.001 - 5.0).collect();
+        let base = Tensor::new(data, &[COLS, ROWS]).unwrap();
+        transpose2d(&base)
+    }
+
+    #[test]
+    fn bench_elementwise_mul_mask_contiguous_vs_transposed_upstream() {
+        let out_value = contiguous_tensor(); // mask_src（`out_value`）は常に contiguous
