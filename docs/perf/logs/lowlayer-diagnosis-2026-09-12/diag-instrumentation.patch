+            let _ = elementwise_mul_mask(&g_contig, &out_value, |v| v > 0.0);
+            let _ = elementwise_mul_mask(&g_transposed, &out_value, |v| v > 0.0);
+        }
+
+        let mut contig_ns = Vec::with_capacity(ITERS);
+        for _ in 0..ITERS {
+            let start = Instant::now();
+            let r = elementwise_mul_mask(&g_contig, &out_value, |v| v > 0.0);
+            contig_ns.push(start.elapsed().as_nanos());
+            std::hint::black_box(&r);
+        }
+
+        let mut transposed_ns = Vec::with_capacity(ITERS);
+        for _ in 0..ITERS {
+            let start = Instant::now();
+            let r = elementwise_mul_mask(&g_transposed, &out_value, |v| v > 0.0);
+            transposed_ns.push(start.elapsed().as_nanos());
+            std::hint::black_box(&r);
+        }
+
+        // `dense_vec` 単体（= `contiguous()` の内訳）も分離計測する。
+        let mut dense_vec_contig_ns = Vec::with_capacity(ITERS);
+        for _ in 0..ITERS {
+            let start = Instant::now();
+            let r = dense_vec(&g_contig);
+            dense_vec_contig_ns.push(start.elapsed().as_nanos());
+            std::hint::black_box(&r);
+        }
+        let mut dense_vec_transposed_ns = Vec::with_capacity(ITERS);
+        for _ in 0..ITERS {
+            let start = Instant::now();
+            let r = dense_vec(&g_transposed);
+            dense_vec_transposed_ns.push(start.elapsed().as_nanos());
+            std::hint::black_box(&r);
+        }
