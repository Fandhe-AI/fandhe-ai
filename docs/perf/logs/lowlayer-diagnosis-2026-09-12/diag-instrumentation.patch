+//! backward の内訳計時（診断専用・本番経路には影響しない）。
+//!
+//! 学習 1 step の `backward` 区間のうち GEMM 系 VJP（`matmul_vjp`・
+//! `Op::LinearResident`／`Op::LinearAct` の GEMM 呼び出し）以外
+//! （活性化マスク・elementwise VJP・転置・materialize・loss 系）が
+//! それぞれどれだけ占めるかを実測するための一時的な計装。
+//!
+//! 環境変数 `FANDHE_DIAG_BACKWARD` が設定されている場合のみ
+//! `std::time::Instant` で計測する（未設定時は `Instant::now()` すら
+//! 呼ばない早期 return とし、通常経路のオーバーヘッドを avoid する）。
+//! `thread_local!` のカウンタへ蓄積し、`backward.rs::backward_impl` の
+//! 呼び出し末尾（1 step 相当）で 1 行の機械可読な診断行を stderr へ
+//! 出力してからリセットする（`report_backward` 参照）。
+//!
+//! 本モジュールは診断専用のスクラッチであり、恒久実装ではない
+//! （`.claude/rules/code-comment-style.md` の「何を書かないか」に反して
+//! 一時計装である旨をあえて明記する）。
+
+use std::cell::Cell;
+use std::sync::OnceLock;
+use std::time::Instant;
+
+/// 計装対象のカテゴリ。`docs` 側の要求どおり gemm／mask／ewise／
+/// transpose／materialize／loss の 6 分類とする。
+#[derive(Clone, Copy)]
+pub(crate) enum Category {
+    /// GEMM 系 VJP: `matmul_vjp` 全体・`Op::LinearResident` の
+    /// `gemm_resident_lhs`／`gemm_fp32_strict`（`gemm_fp32_strict_into`
+    /// を含む grad staging 書き込み）・`Op::LinearAct` の `matmul_vjp`。
+    Gemm,
+    /// 活性化マスク: `elementwise_mul_mask`・`tanh_grad_factor`・
+    /// `sigmoid_grad_factor`。
+    Mask,
+    /// elementwise VJP: `eval::mul`・`reduce_to_shape`（Add／Mul／bias
+    /// の VJP）。
+    Ewise,
+    /// `transpose2d` 呼び出し（`matmul_vjp` 内部のものは gemm 側の
+    /// 計測区間に内包されるため、ここでは `Op::LinearResident` の
+    /// `x_t`／`g_t` 等、gemm 呼び出しの外側で行う transpose のみを
+    /// 対象とする。呼び出し側のコメントで明示する）。
+    Transpose,
+    /// `materialize_fallible` 呼び出し（`grad.rs` の各 `Op` 分岐・
+    /// `backward.rs` のノード自身の forward 値実体化の両方）。
+    Materialize,
+    /// loss 系 VJP: `ops.mse_loss_backward`／`mse_loss_vjp`・
+    /// `cross_entropy_loss_vjp`。
+    Loss,
+}
+
+/// カテゴリ別の累積時間（ns）と、gemm／mask 呼び出し回数（要求された
+/// 出力形式 `gemm_calls`／`mask_calls`）。`vjp_calls`／`vjp_total_ns`・
+/// `backward_total_ns` は別カウンタ（`vjp()` 全体・`backward_impl`
+/// 全体はそれぞれ専用の計測区間を持つため）。
+#[derive(Default)]
+struct Counters {
+    gemm_ns: Cell<u64>,
+    mask_ns: Cell<u64>,
+    ewise_ns: Cell<u64>,
+    transpose_ns: Cell<u64>,
+    materialize_ns: Cell<u64>,
+    loss_ns: Cell<u64>,
+    vjp_ns: Cell<u64>,
+    gemm_calls: Cell<u64>,
+    mask_calls: Cell<u64>,
+    vjp_calls: Cell<u64>,
+}
+
+thread_local! {
+    static COUNTERS: Counters = Counters::default();
+}
+
+/// `FANDHE_DIAG_BACKWARD` の有無をプロセス内で 1 度だけ判定する
+/// （`OnceLock`。環境変数読み取りはスレッド間で不変という前提）。
+pub(crate) fn is_enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("FANDHE_DIAG_BACKWARD").is_some())
+}
+
+/// `cat` に分類される処理 `f` の実行時間を計測して加算する。
+/// `is_enabled()` が `false` の場合は `Instant::now()` を呼ばず `f()` を
+/// そのまま実行する（無効時のオーバーヘッドをほぼゼロにする）。
+pub(crate) fn time<T>(cat: Category, f: impl FnOnce() -> T) -> T {
+    if !is_enabled() {
+        return f();
+    }
+    let start = Instant::now();
+    let out = f();
+    let elapsed = start.elapsed().as_nanos() as u64;
+    COUNTERS.with(|c| {
+        let cell = match cat {
+            Category::Gemm => &c.gemm_ns,
+            Category::Mask => &c.mask_ns,
+            Category::Ewise => &c.ewise_ns,
+            Category::Transpose => &c.transpose_ns,
+            Category::Materialize => &c.materialize_ns,
+            Category::Loss => &c.loss_ns,
+        };
+        cell.set(cell.get() + elapsed);
+        match cat {
+            Category::Gemm => c.gemm_calls.set(c.gemm_calls.get() + 1),
+            Category::Mask => c.mask_calls.set(c.mask_calls.get() + 1),
+            _ => {}
+        }
+    });
+    out
+}
+
+/// `vjp()` 関数全体の実行時間を計測する（`vjp_total`／`vjp_calls`）。
+/// ノード 1 個の VJP 呼び出しごとに 1 回加算される（`backward_impl` の
+/// 逆走査ループから 1 step あたり複数回呼ばれる）。
+pub(crate) fn time_vjp<T>(f: impl FnOnce() -> T) -> T {
+    if !is_enabled() {
+        return f();
+    }
+    let start = Instant::now();
+    let out = f();
+    let elapsed = start.elapsed().as_nanos() as u64;
+    COUNTERS.with(|c| {
+        c.vjp_ns.set(c.vjp_ns.get() + elapsed);
+        c.vjp_calls.set(c.vjp_calls.get() + 1);
+    });
+    out
+}
+
+/// `cat` の計測区間を開始する。呼び出し元のコードが途中に `return`
+/// （早期リターン）を含み `time()`（クロージャベース）で素直に包めない
+/// 場合に使う（例: `Op::MseLoss`／`Op::CrossEntropyLoss` の VJP 分岐。
+/// エラーで早期 return した場合は対応する [`record`] へ到達せず当該
+/// 区間の計測が欠落するが、診断専用のため許容する）。`is_enabled()` が
+/// `false` の場合は `Instant::now()` を呼ばず `None` を返す。
+pub(crate) fn maybe_start() -> Option<Instant> {
+    is_enabled().then(Instant::now)
+}
+
+/// [`maybe_start`] で取得した開始時刻から経過時間を測り、`cat` の
+/// 累積へ加算する。`start` が `None`（無効時に開始しなかった）の場合は
+/// 何もしない。
+pub(crate) fn record(cat: Category, start: Option<Instant>) {
+    let Some(start) = start else {
+        return;
+    };
+    let elapsed = start.elapsed().as_nanos() as u64;
+    COUNTERS.with(|c| {
+        let cell = match cat {
+            Category::Gemm => &c.gemm_ns,
+            Category::Mask => &c.mask_ns,
+            Category::Ewise => &c.ewise_ns,
+            Category::Transpose => &c.transpose_ns,
+            Category::Materialize => &c.materialize_ns,
+            Category::Loss => &c.loss_ns,
+        };
+        cell.set(cell.get() + elapsed);
+        match cat {
+            Category::Gemm => c.gemm_calls.set(c.gemm_calls.get() + 1),
+            Category::Mask => c.mask_calls.set(c.mask_calls.get() + 1),
+            _ => {}
+        }
+    });
+}
+
+/// `backward_impl` 呼び出し 1 回（1 step 相当）の終わりに、累積した
+/// カテゴリ別カウンタと `total_ns`（`backward_impl` 全体の壁時計時間。
+/// 呼び出し元〈`backward.rs`〉が計測して渡す）を 1 行の機械可読な形式で
+/// stderr へ出力し、カウンタをリセットする。`is_enabled()` が `false`
+/// の場合は何もしない（呼び出し元も `Instant::now()` を呼ばない設計に
+/// なっている前提。`backward.rs::backward_impl` 参照）。
+pub(crate) fn report_backward(total_ns: u64) {
+    if !is_enabled() {
+        return;
+    }
+    COUNTERS.with(|c| {
+        eprintln!(
+            "DIAG_BACKWARD total_ns={} vjp_ns={} gemm_ns={} mask_ns={} ewise_ns={} \
+             transpose_ns={} materialize_ns={} loss_ns={} vjp_calls={} gemm_calls={} \
+             mask_calls={}",
+            total_ns,
+            c.vjp_ns.get(),
+            c.gemm_ns.get(),
+            c.mask_ns.get(),
+            c.ewise_ns.get(),
+            c.transpose_ns.get(),
+            c.materialize_ns.get(),
+            c.loss_ns.get(),
+            c.vjp_calls.get(),
+            c.gemm_calls.get(),
+            c.mask_calls.get(),
+        );
+        c.vjp_ns.set(0);
+        c.gemm_ns.set(0);
+        c.mask_ns.set(0);
+        c.ewise_ns.set(0);
+        c.transpose_ns.set(0);
+        c.materialize_ns.set(0);
+        c.loss_ns.set(0);
+        c.vjp_calls.set(0);
+        c.gemm_calls.set(0);
+        c.mask_calls.set(0);
+    });
+}
