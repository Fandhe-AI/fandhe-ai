+#[cfg(test)]
+mod diag_elementwise_mask_bench {
+    use super::*;
+    use std::time::Instant;
+
+    const ITERS: usize = 1000;
+    const ROWS: usize = 64;
+    const COLS: usize = 256;
+
+    fn median(mut v: Vec<u128>) -> u128 {
+        v.sort_unstable();
+        v[v.len() / 2]
+    }
+
+    fn contiguous_tensor() -> Tensor<f32> {
+        let data: Vec<f32> = (0..ROWS * COLS).map(|i| (i as f32) * 0.001 - 5.0).collect();
+        Tensor::new(data, &[ROWS, COLS]).unwrap()
