+//! イシュー #3701 の計測専用モジュール（`probe-3701.patch` でのみ存在する。main には入れない）。
+//!
+//! 役割: `CpuBackendOps::gemm_device`（`ops.rs`）と `CpuMemory::download_owned`／`download`（`memory.rs`）の
+//! 内側に置いた計時点の結果を、呼び出し元スレッドの thread_local に**上書き**で保存する。
+//! 診断テスト（`crates/facade/tests/cpu_gemm_s1_inner_split_diag.rs`）が外側の区間の計時の直後に
+//! `take_*` で取り出す。累積はしない（1 反復 1 回の上書き）。
+//! 計算・出力の bit・確保の呼び出し・drop の順序は変えない。足すのは `Instant::now()` と書き込みだけで、`unsafe`・依存は無い。
+//! 区間名・計時点は `docs/perf/logs/cpu-gemm-gemm-device-split-3701/RULE.txt` を正とする。
+
+use std::cell::Cell;
+
+/// `gemm_device` の内側の区間名（`GemmDeviceSplit` の並びと同じ）。
+pub const GD_PHASES: [&str; 4] = ["gd_checks", "gd_alloc_zeroed", "gd_compute", "gd_wrap"];
+/// `download_owned` の内側の区間名。
+pub const DO_PHASES: [&str; 5] = [
+    "do_checks",
+    "do_prepack_clear",
+    "do_take",
+    "do_tensor_new",
+    "do_shell_drop",
+];
+/// `download` の内側の区間名。
+pub const DC_PHASES: [&str; 3] = ["dc_checks", "dc_to_vec", "dc_tensor_new"];
+
+/// 経路種別: `download_owned` の本経路。
+pub const KIND_OWNED: u8 = 0;
+/// 経路種別: `download`（コピー版）。
+pub const KIND_COPY: u8 = 1;
+/// 経路種別: `download_owned` がプール付きバッファのためコピー版へ退いた経路。
+pub const KIND_POOL_FALLBACK: u8 = 2;
+
+thread_local! {
+    static GEMM_DEVICE: Cell<Option<[f64; 4]>> = const { Cell::new(None) };
+    static DOWNLOAD: Cell<Option<(u8, [f64; 5])>> = const { Cell::new(None) };
+    static TAKE_DATA: Cell<Option<[f64; 2]>> = const { Cell::new(None) };
+}
+
+/// `gemm_device` の区間（秒）を記録する（`ops.rs` から呼ぶ）。
+pub fn set_gemm_device(v: [f64; 4]) {
+    GEMM_DEVICE.with(|c| c.set(Some(v)));
+}
+
+/// 直近の `gemm_device` の区間を取り出す（取り出すと `None` に戻る）。
+/// 計測窓内から呼ばれるため固定長配列をそのまま返し、確保しない（区間名の対応付けは呼び出し側が窓の外で行う）。
+pub fn take_gemm_device() -> Option<[f64; 4]> {
+    GEMM_DEVICE.with(Cell::take)
+}
+
+/// `download_owned` の区間を記録する（`memory.rs` から呼ぶ）。
+pub fn set_download_owned(v: [f64; 5]) {
+    DOWNLOAD.with(|c| c.set(Some((KIND_OWNED, v))));
+}
+
+/// `download` の区間を記録する（`memory.rs` から呼ぶ。残り 2 要素は未使用）。
+pub fn set_download_copy(v: [f64; 3]) {
+    DOWNLOAD.with(|c| c.set(Some((KIND_COPY, [v[0], v[1], v[2], 0.0, 0.0]))));
+}
+
+/// 直近の `download` 系の記録の種別をプール退避に書き換える（`download_owned` がコピー版へ退いたとき）。
+pub fn mark_pool_fallback() {
+    DOWNLOAD.with(|c| {
+        if let Some((_, v)) = c.get() {
+            c.set(Some((KIND_POOL_FALLBACK, v)));
+        }
+    });
+}
+
+/// `take_data` の内訳（prepack 破棄・`mem::take`）を記録する（`memory.rs` の handle から呼ぶ）。
+pub fn set_take_data(v: [f64; 2]) {
+    TAKE_DATA.with(|c| c.set(Some(v)));
+}
+
+/// 直近の `take_data` の内訳を取り出す（`download_owned` が合成に使う）。
+pub fn take_take_data() -> Option<[f64; 2]> {
+    TAKE_DATA.with(Cell::take)
+}
+
+/// 直近の `download`／`download_owned` の区間を `(経路種別名, 区間)` で取り出す。
+/// 計測窓内から呼ばれるため固定長配列と種別名だけを返し、確保しない。
+/// コピー版・プール退避版は先頭 3 要素だけが有効（`DC_PHASES` の並び）、本経路は 5 要素（`DO_PHASES` の並び）。
+pub fn take_download() -> Option<(&'static str, [f64; 5])> {
+    DOWNLOAD.with(Cell::take).map(|(kind, v)| match kind {
+        KIND_COPY => ("copy", v),
+        KIND_POOL_FALLBACK => ("owned_pool_fallback", v),
+        _ => ("owned", v),
+    })
+}
