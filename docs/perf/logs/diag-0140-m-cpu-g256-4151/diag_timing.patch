+//! イシュー #4151 診断専用: 2D 動的分配の GEMM 1 回を、固定費の区間（pre・fork_wake・stage・alloc・pack・
+//! kernel・join）に分けて積算する。
+//!
+//! 本ファイルは `docs/perf/logs/diag-0140-m-cpu-g256-4151/diag_timing.patch` が計測用の複製ツリーにだけ
+//! 追加するもので、main にはコミットしない（`determinism_inventory` が atomic・rayon 使用箇所を
+//! allowlist で固定しているため、本番ツリーに計時フックを置かない）。
+//!
+//! 呼び出し元: `gemm_blis_parallel_with_transpose`（`enter`）、`gemm_blis_two_d_dynamic_region`
+//! （`mark_grid`／`mark_split`／`par_begin`／`par_end`）、`run_two_d_job`（job 内の `job_*`）、
+//! `gemm_blis_ic_loop`（`add_a`／`add_k`／`add_calls`）。時計は `Instant`（macOS の分解能は約 41.7 ns の
+//! ため、マイクロカーネル 1 回ごとには計らずループ単位で計る）。job の記録は `par_end` が回収して
+//! 1 回の GEMM 呼び出し（region）の要約にし、`suffix` が全 region の中央値を `key=value` で書き出す。
+//! `ARMED` は `reset` から `suffix` までの間だけ真（warmup と対象外の系列を数えない）。
+
+use std::cell::{Cell, RefCell};
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::time::Instant;
+
+static ARMED: AtomicBool = AtomicBool::new(false);
+static TILE_MR: AtomicUsize = AtomicUsize::new(0);
+static TILE_NR: AtomicUsize = AtomicUsize::new(0);
+static JOBS: Mutex<Vec<JobRec>> = Mutex::new(Vec::new());
+static REGIONS: Mutex<Vec<Region>> = Mutex::new(Vec::new());
+
+#[derive(Clone, Copy, Default)]
+struct JobAcc {
+    stage_in: u64,
+    alloc: u64,
+    pack_b: u64,
+    pack_a: u64,
+    kernel: u64,
+    stage_out: u64,
+    calls: u64,
+}
+
+#[derive(Clone, Copy)]
+struct JobRec {
+    worker: usize,
+    start: Instant,
+    end: Instant,
+    acc: JobAcc,
+}
+
+#[derive(Clone, Copy, Default)]
+struct Region {
+    call: u64,
+    pre: u64,
+    grid: u64,
+    split: u64,
+    fork_wake_min: u64,
+    fork_wake_max: u64,
+    join: u64,
+    wall: u64,
+    jobs: u64,
+    p_used: u64,
+    stage_in: u64,
+    alloc: u64,
+    pack_b: u64,
+    pack_a: u64,
+    kernel: u64,
+    stage_out: u64,
+    kernel_crit: u64,
+    calls: u64,
+}
+
+thread_local! {
+    static ENTER: Cell<Option<Instant>> = const { Cell::new(None) };
+    static MARKS: Cell<[Option<Instant>; 3]> = const { Cell::new([None; 3]) };
+    static ACC: RefCell<JobAcc> = RefCell::new(JobAcc::default());
+}
+
+fn ns(from: Instant, to: Instant) -> u64 {
+    u64::try_from(to.saturating_duration_since(from).as_nanos()).unwrap_or(u64::MAX)
+}
+
+/// GEMM 入口で呼ぶ。pre 区間の起点。
+pub fn enter() {
+    ENTER.with(|c| c.set(Some(Instant::now())));
+    MARKS.with(|c| c.set([None; 3]));
+}
+
+/// `job_grid` 直後に呼ぶ。
+pub fn mark_grid() {
+    MARKS.with(|c| {
+        let mut m = c.get();
+        m[0] = Some(Instant::now());
+        c.set(m);
+    });
+}
+
+/// `split_c_into_jobs` 直後に呼ぶ。
+pub fn mark_split() {
+    MARKS.with(|c| {
+        let mut m = c.get();
+        m[1] = Some(Instant::now());
+        c.set(m);
+    });
+}
+
+/// `par_iter_mut` の直前に呼ぶ。
+pub fn par_begin() {
+    MARKS.with(|c| {
+        let mut m = c.get();
+        m[2] = Some(Instant::now());
+        c.set(m);
+    });
+    if let Ok(mut g) = JOBS.lock() {
+        g.clear();
+    }
+}
+
+fn with_acc(f: impl FnOnce(&mut JobAcc)) {
+    ACC.with(|c| f(&mut c.borrow_mut()));
+}
+
+/// job の先頭で呼ぶ（thread_local の積算を空にする）。
+pub fn job_begin() {
+    ACC.with(|c| *c.borrow_mut() = JobAcc::default());
+}
+
+pub fn job_stage_in(a: Instant, b: Instant) {
+    with_acc(|t| t.stage_in += ns(a, b));
+}
+
+pub fn job_alloc(a: Instant, b: Instant) {
+    with_acc(|t| t.alloc += ns(a, b));
+}
+
+pub fn add_b(a: Instant, b: Instant) {
+    with_acc(|t| t.pack_b += ns(a, b));
+}
+
+pub fn add_a(a: Instant, b: Instant) {
+    with_acc(|t| t.pack_a += ns(a, b));
+}
+
+pub fn add_k(a: Instant, b: Instant) {
+    with_acc(|t| t.kernel += ns(a, b));
+}
+
+/// マイクロカーネルの呼び出し回数（ir×jr ループの反復数 = タイル数）と、そのタイルの MR・NR。
+pub fn add_calls(n: usize, mr: usize, nr: usize) {
+    TILE_MR.store(mr, Ordering::Relaxed);
+    TILE_NR.store(nr, Ordering::Relaxed);
+    with_acc(|t| t.calls += n as u64);
+}
+
+pub fn job_stage_out(a: Instant, b: Instant) {
+    with_acc(|t| t.stage_out += ns(a, b));
+}
+
+/// job の末尾で 1 回だけ呼ぶ。記録を共有の `JOBS` へ積む。
+pub fn job_end(start: Instant, end: Instant) {
+    if !ARMED.load(Ordering::Relaxed) {
+        return;
+    }
+    let acc = ACC.with(|c| *c.borrow());
+    let rec = JobRec {
+        worker: rayon::current_thread_index().unwrap_or(usize::MAX),
+        start,
+        end,
+        acc,
+    };
+    if let Ok(mut g) = JOBS.lock() {
+        g.push(rec);
+    }
+}
+
+/// `par_iter_mut` から戻った直後に呼ぶ。job 記録を回収して region の要約を作る。
+pub fn par_end() {
+    let t_end = Instant::now();
+    if !ARMED.load(Ordering::Relaxed) {
+        return;
+    }
+    let (Some(t_enter), marks) = (ENTER.with(Cell::get), MARKS.with(Cell::get)) else {
+        return;
+    };
+    let (Some(t_grid), Some(t_split), Some(t_par)) = (marks[0], marks[1], marks[2]) else {
+        return;
+    };
+    let jobs: Vec<JobRec> = JOBS.lock().map(|g| g.clone()).unwrap_or_default();
+    if jobs.is_empty() {
+        return;
+    }
+    let first = jobs.iter().map(|j| j.start).min().unwrap_or(t_par);
+    let last = jobs.iter().map(|j| j.end).max().unwrap_or(t_end);
+    // worker ごとの最初の job の開始（fork_wake の min・max 用）と kernel の worker 別合計。
+    let mut workers: Vec<(usize, Instant, u64)> = Vec::new();
+    for j in &jobs {
+        if let Some(w) = workers.iter_mut().find(|w| w.0 == j.worker) {
+            w.1 = w.1.min(j.start);
+            w.2 += j.acc.kernel;
+        } else {
+            workers.push((j.worker, j.start, j.acc.kernel));
+        }
+    }
+    let mut r = Region {
+        call: ns(t_enter, t_end),
+        pre: ns(t_enter, t_par),
+        grid: ns(t_enter, t_grid),
+        split: ns(t_grid, t_split),
+        fork_wake_min: ns(t_par, first),
+        fork_wake_max: workers.iter().map(|w| ns(t_par, w.1)).max().unwrap_or(0),
+        join: ns(last, t_end),
+        wall: ns(t_par, t_end),
+        jobs: jobs.len() as u64,
+        p_used: workers.len() as u64,
+        kernel_crit: workers.iter().map(|w| w.2).max().unwrap_or(0),
+        ..Region::default()
+    };
+    for j in &jobs {
+        r.stage_in += j.acc.stage_in;
+        r.alloc += j.acc.alloc;
+        r.pack_b += j.acc.pack_b;
+        r.pack_a += j.acc.pack_a;
+        r.kernel += j.acc.kernel;
+        r.stage_out += j.acc.stage_out;
+        r.calls += j.acc.calls;
+    }
+    if let Ok(mut g) = REGIONS.lock() {
+        g.push(r);
+    }
+}
+
+/// 系列の warmup 後に呼ぶ。積算を空にして計数を始める。
+pub fn reset() {
+    if let Ok(mut g) = REGIONS.lock() {
+        g.clear();
+    }
+    ARMED.store(true, Ordering::Relaxed);
+}
+
+fn median(mut v: Vec<u64>) -> u64 {
+    v.sort_unstable();
+    v.get(v.len() / 2).copied().unwrap_or(0)
+}
+
+/// 系列の測定後に呼ぶ。計数を止め、全 region の中央値を ` key=value` 形式で返す（region が 0 件なら空）。
+pub fn suffix() -> String {
+    ARMED.store(false, Ordering::Relaxed);
+    let regions: Vec<Region> = REGIONS.lock().map(|g| g.clone()).unwrap_or_default();
+    if regions.is_empty() {
+        return String::new();
+    }
+    let m = |f: fn(&Region) -> u64| median(regions.iter().map(f).collect());
+    format!(
+        " d_regions={} d_mr={} d_nr={} d_jobs={} d_p_used={} d_n_calls={} d_call_ns={} d_pre_ns={} \
+d_grid_ns={} d_split_ns={} d_fork_wake_min_ns={} d_fork_wake_max_ns={} d_stage_in_ns={} \
+d_alloc_ns={} d_pack_b_ns={} d_pack_a_ns={} d_kernel_ns={} d_stage_out_ns={} \
+d_kernel_crit_ns={} d_join_ns={} d_region_wall_ns={}",
+        regions.len(),
+        TILE_MR.load(Ordering::Relaxed),
+        TILE_NR.load(Ordering::Relaxed),
+        m(|r| r.jobs),
+        m(|r| r.p_used),
+        m(|r| r.calls),
+        m(|r| r.call),
+        m(|r| r.pre),
+        m(|r| r.grid),
+        m(|r| r.split),
+        m(|r| r.fork_wake_min),
+        m(|r| r.fork_wake_max),
+        m(|r| r.stage_in),
+        m(|r| r.alloc),
+        m(|r| r.pack_b),
+        m(|r| r.pack_a),
+        m(|r| r.kernel),
+        m(|r| r.stage_out),
+        m(|r| r.kernel_crit),
+        m(|r| r.join),
+        m(|r| r.wall),
+    )
+}
