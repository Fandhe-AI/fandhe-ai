@@ -0,0 +1,108 @@
+//! イシュー #3614 診断専用: 2D 動的分配の job 内で A pack・B pack・kernel の時間を積算する。
+//!
+//! 本ファイルは `docs/perf/logs/cpu-pack-kernel-breakdown-3614/diag_timing.patch` が計測用の
+//! 複製ツリーにだけ追加するもので、main にはコミットしない（`determinism_inventory` が
+//! atomic RMW・rayon 使用箇所を allowlist で固定しているため、本番ツリーに計時フックを置かない）。
+//!
+//! 呼び出し元: `run_two_d_job`（job 全体・B pack）と `gemm_blis_ic_loop`（A pack・kernel）。
+//! 積算は thread_local の `Cell` で行い、job の終わりに 1 回だけ `static Mutex` へ合算する
+//! （`fetch_add` も rayon も使わない）。区間はループ全体を 1 回の `Instant` 対で包み、
+//! 区間の終わりの時刻を次の区間の始まりへ流用して `Instant::now()` の呼び出し回数を減らす。
+
+use std::cell::Cell;
+use std::sync::Mutex;
+use std::time::Instant;
+
+/// 全 worker の合計（ns と区間数）。`jobs` は合算された job の数。
+#[derive(Clone, Copy, Default, Debug)]
+pub struct Totals {
+    pub job_ns: u64,
+    pub a_pack_ns: u64,
+    pub b_pack_ns: u64,
+    pub kernel_ns: u64,
+    pub jobs: u64,
+    pub a_intervals: u64,
+    pub b_intervals: u64,
+    pub k_intervals: u64,
+}
+
+static TOTALS: Mutex<Totals> = Mutex::new(Totals {
+    job_ns: 0,
+    a_pack_ns: 0,
+    b_pack_ns: 0,
+    kernel_ns: 0,
+    jobs: 0,
+    a_intervals: 0,
+    b_intervals: 0,
+    k_intervals: 0,
+});
+
+thread_local! {
+    static LOCAL: Cell<Totals> = const { Cell::new(Totals {
+        job_ns: 0, a_pack_ns: 0, b_pack_ns: 0, kernel_ns: 0,
+        jobs: 0, a_intervals: 0, b_intervals: 0, k_intervals: 0,
+    }) };
+}
+
+fn ns_between(from: Instant, to: Instant) -> u64 {
+    u64::try_from(to.duration_since(from).as_nanos()).unwrap_or(u64::MAX)
+}
+
+fn with_local(f: impl FnOnce(&mut Totals)) {
+    LOCAL.with(|c| {
+        let mut t = c.get();
+        f(&mut t);
+        c.set(t);
+    });
+}
+
+/// A pack 区間 `[from, to]` を加算する。
+pub fn add_a(from: Instant, to: Instant) {
+    with_local(|t| {
+        t.a_pack_ns += ns_between(from, to);
+        t.a_intervals += 1;
+    });
+}
+
+/// B pack 区間 `[from, to]` を加算する。
+pub fn add_b(from: Instant, to: Instant) {
+    with_local(|t| {
+        t.b_pack_ns += ns_between(from, to);
+        t.b_intervals += 1;
+    });
+}
+
+/// kernel 区間 `[from, to]` を加算する。
+pub fn add_k(from: Instant, to: Instant) {
+    with_local(|t| {
+        t.kernel_ns += ns_between(from, to);
+        t.k_intervals += 1;
+    });
+}
+
+/// job の終了時に 1 回呼ぶ。job 全体の時間を足し、スレッドローカルを共有へ合算してクリアする。
+pub fn end_job(from: Instant) {
+    let to = Instant::now();
+    let mut local = LOCAL.with(Cell::take);
+    local.job_ns += ns_between(from, to);
+    local.jobs += 1;
+    if let Ok(mut g) = TOTALS.lock() {
+        g.job_ns += local.job_ns;
+        g.a_pack_ns += local.a_pack_ns;
+        g.b_pack_ns += local.b_pack_ns;
+        g.kernel_ns += local.kernel_ns;
+        g.jobs += local.jobs;
+        g.a_intervals += local.a_intervals;
+        g.b_intervals += local.b_intervals;
+        g.k_intervals += local.k_intervals;
+    }
+}
+
+/// 合算値を取り出して 0 に戻す（example が warmup 後のリセットと計測後の読み出しに使う）。
+#[doc(hidden)]
+pub fn take_and_reset() -> Totals {
+    TOTALS
+        .lock()
+        .map(|mut g| std::mem::take(&mut *g))
+        .unwrap_or_default()
+}
