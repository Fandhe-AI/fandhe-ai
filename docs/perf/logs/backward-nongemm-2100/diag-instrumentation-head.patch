+            median(contig_ns)
+        );
+        eprintln!(
+            "[diag] elementwise_mul_mask transposed-view median = {} ns",
+            median(transposed_ns)
+        );
+        eprintln!(
+            "[diag] dense_vec(contiguous) median = {} ns",
+            median(dense_vec_contig_ns)
+        );
+        eprintln!(
+            "[diag] dense_vec(transposed view) median = {} ns",
+            median(dense_vec_transposed_ns)
+        );
+    }
+}
