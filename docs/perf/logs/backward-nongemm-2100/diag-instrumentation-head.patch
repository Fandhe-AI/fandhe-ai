+        let g_transposed = transposed_view_tensor();
+
+        assert!(g_contig.is_contiguous(), "対照条件が前提から外れている");
+        assert!(
+            !g_transposed.is_contiguous(),
+            "reuse 再現条件が前提から外れている（transpose2d が non-contiguous \
+             view を返さなくなった可能性）"
+        );
+
+        // ウォームアップ
+        for _ in 0..50 {
+            let _ = elementwise_mul_mask(&g_contig, &out_value, |v| v > 0.0);
+            let _ = elementwise_mul_mask(&g_transposed, &out_value, |v| v > 0.0);
+        }
+
+        let mut contig_ns = Vec::with_capacity(ITERS);
+        for _ in 0..ITERS {
+            let start = Instant::now();
+            let r = elementwise_mul_mask(&g_contig, &out_value, |v| v > 0.0);
+            contig_ns.push(start.elapsed().as_nanos());
