+//! backward の内訳計時（診断専用・本番経路には影響しない）。
+//!
+//! 学習 1 step の `backward` 区間のうち GEMM 系 VJP（`matmul_vjp`・
+//! `Op::LinearResident`／`Op::LinearAct` の GEMM 呼び出し）以外
+//! （活性化マスク・elementwise VJP・転置・materialize・勾配 accumulate・
+//! loss 系）がそれぞれどれだけ占めるかを実測するための一時的な計装
+//! （イシュー #2100。`docs/perf/lowlayer-diagnosis-2026-09-12.md` §4 の
+//! HEAD 再適用版。旧パッチの HEAD 移植であり、本番コードへは残さない。
+//! パッチ本体と手順は `docs/perf/logs/backward-nongemm-2100/` を参照）。
+//!
+//! 環境変数 `FANDHE_DIAG_BACKWARD` が設定されている場合のみ
+//! `std::time::Instant` で計測する（未設定時は `Instant::now()` すら
+//! 呼ばない早期 return とし、通常経路のオーバーヘッドを避ける）。
+//! `thread_local!` のカウンタへ蓄積し、`backward.rs::backward_impl` の
+//! 呼び出し末尾（1 step 相当）で 1 行の機械可読な診断行
+//! （`DIAG_BACKWARD seq=.. total_ns=.. ...` の key=value 形式）を
+//! stderr へ出力してからリセットする（`report_backward` 参照）。集計は
+//! `aggregate_backward_diag.py` が担う。
+//!
+//! 本モジュールは診断専用のスクラッチであり、恒久実装ではない。
+
+use std::cell::Cell;
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Instant;
+
+/// 計装対象のカテゴリ。gemm／mask／ewise／transpose／materialize／
+/// accumulate／loss の 7 分類（旧パッチの 6 分類に、`total - vjp` に
+/// 埋もれていた勾配 accumulate 段を加えた）。`fill` は Gemm の内訳
+/// サブカウンタとして別建てで持つ（[`record_fill`]）。
+#[derive(Clone, Copy)]
+pub(crate) enum Category {
+    /// GEMM 系 VJP: `matmul_vjp` 全体・`Op::LinearResident` の
+    /// `gemm_resident_lhs`／`gemm_fp32_strict`・resident grad staging への
+    /// 書き込み（`fill_resident_weight_grad`。bias 縮約を含みうるため
+    /// 内訳を `fill_ns` に別掲する）・`Op::LinearAct` の `matmul_vjp`。
+    Gemm,
+    /// 活性化マスク: `elementwise_mul_mask`・`tanh_grad_factor`・
+    /// `sigmoid_grad_factor`。
+    Mask,
+    /// elementwise VJP: `vjp_elementwise_mul`・`reduce_to_shape`・
+    /// `reduce_bias_grad`（Add／Mul／bias の VJP）。
+    Ewise,
+    /// `transpose2d` 呼び出し（`matmul_vjp` 内部のものは Gemm 区間に
+    /// 内包されるため、`Op::LinearResident` の gemm 呼び出しの外側で行う
+    /// transpose のみが対象）。
+    Transpose,
+    /// `materialize_fallible` 呼び出し（`grad.rs` の各 `Op` 分岐・
+    /// `backward.rs` のノード自身の forward 値実体化の両方）。
+    Materialize,
+    /// `backward.rs::accumulate`（fan-out 勾配の合算）。
+    Accumulate,
+    /// loss 系 VJP: `ops.mse_loss_backward`／`mse_loss_vjp`・
+    /// `cross_entropy_loss_vjp`。
+    Loss,
+}
+
+/// カテゴリ別の累積時間（ns）と gemm／mask 呼び出し回数。
+#[derive(Default)]
+struct Counters {
+    gemm_ns: Cell<u64>,
+    fill_ns: Cell<u64>,
+    mask_ns: Cell<u64>,
+    ewise_ns: Cell<u64>,
+    transpose_ns: Cell<u64>,
+    materialize_ns: Cell<u64>,
+    accumulate_ns: Cell<u64>,
+    loss_ns: Cell<u64>,
+    vjp_ns: Cell<u64>,
+    gemm_calls: Cell<u64>,
+    mask_calls: Cell<u64>,
+    vjp_calls: Cell<u64>,
+}
+
+thread_local! {
+    static COUNTERS: Counters = Counters::default();
+}
+
+/// `DIAG_BACKWARD` 行の通し番号（プロセス全体で単調増加）。集計側が
+/// stderr の行順だけに頼らず step を復元できるようにする。
+static SEQ: AtomicU64 = AtomicU64::new(0);
+
+/// `FANDHE_DIAG_BACKWARD` の有無をプロセス内で 1 度だけ判定する
+/// （`OnceLock`。環境変数の値は解釈せず有無のみを見る）。
+pub(crate) fn is_enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("FANDHE_DIAG_BACKWARD").is_some())
+}
+
+/// `FANDHE_DIAG_MASK_CONTIGUITY` の有無をプロセス内で 1 度だけ判定する
+/// （ホットな Relu arm から毎回環境変数を読まないため `OnceLock` 化）。
+pub(crate) fn mask_contiguity_enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("FANDHE_DIAG_MASK_CONTIGUITY").is_some())
+}
+
+fn add_elapsed(c: &Counters, cat: Category, elapsed: u64) {
+    let cell = match cat {
+        Category::Gemm => &c.gemm_ns,
+        Category::Mask => &c.mask_ns,
+        Category::Ewise => &c.ewise_ns,
+        Category::Transpose => &c.transpose_ns,
+        Category::Materialize => &c.materialize_ns,
+        Category::Accumulate => &c.accumulate_ns,
+        Category::Loss => &c.loss_ns,
+    };
+    cell.set(cell.get() + elapsed);
+    match cat {
+        Category::Gemm => c.gemm_calls.set(c.gemm_calls.get() + 1),
+        Category::Mask => c.mask_calls.set(c.mask_calls.get() + 1),
+        _ => {}
+    }
+}
+
+/// `cat` に分類される処理 `f` の実行時間を計測して加算する。
+/// `is_enabled()` が `false` の場合は `Instant::now()` を呼ばず `f()` を
+/// そのまま実行する。
+pub(crate) fn time<T>(cat: Category, f: impl FnOnce() -> T) -> T {
+    if !is_enabled() {
+        return f();
+    }
+    let start = Instant::now();
+    let out = f();
+    let elapsed = start.elapsed().as_nanos() as u64;
+    COUNTERS.with(|c| add_elapsed(c, cat, elapsed));
+    out
+}
+
+/// `vjp()` 関数全体の実行時間を計測する（`vjp_ns`／`vjp_calls`）。
+pub(crate) fn time_vjp<T>(f: impl FnOnce() -> T) -> T {
+    if !is_enabled() {
+        return f();
+    }
+    let start = Instant::now();
+    let out = f();
+    let elapsed = start.elapsed().as_nanos() as u64;
+    COUNTERS.with(|c| {
+        c.vjp_ns.set(c.vjp_ns.get() + elapsed);
+        c.vjp_calls.set(c.vjp_calls.get() + 1);
+    });
+    out
+}
+
+/// 計測区間を開始する。途中に `return`（早期リターン）を含み
+/// [`time`]（クロージャベース）で素直に包めない場合に使う（例:
+/// `Op::MseLoss` の VJP 分岐）。エラーで早期 return した場合は対応する
+/// [`record`] へ到達せず当該区間の計測が欠落するが、診断専用のため許容
+/// する。`is_enabled()` が `false` の場合は `None` を返す。
+pub(crate) fn maybe_start() -> Option<Instant> {
+    is_enabled().then(Instant::now)
+}
+
+/// [`maybe_start`] で取得した開始時刻から経過時間を測り、`cat` の
+/// 累積へ加算する。`start` が `None` の場合は何もしない。
+pub(crate) fn record(cat: Category, start: Option<Instant>) {
+    let Some(start) = start else {
+        return;
+    };
+    let elapsed = start.elapsed().as_nanos() as u64;
+    COUNTERS.with(|c| add_elapsed(c, cat, elapsed));
+}
+
+/// resident grad staging への書き込み（`fill_resident_weight_grad`）の
+/// 計測終了。`gemm_ns` へ計上（旧パッチの §4 と比較可能）しつつ `fill_ns` にも加算。
+/// GEMM 計算と bias 縮約は分離計時しない。集計器は total−gemm（下界）と total−gemm+fill（上界）を併記する。
+pub(crate) fn record_fill(start: Option<Instant>) {
+    let Some(start) = start else {
+        return;
+    };
+    let elapsed = start.elapsed().as_nanos() as u64;
+    COUNTERS.with(|c| {
+        add_elapsed(c, Category::Gemm, elapsed);
+        c.fill_ns.set(c.fill_ns.get() + elapsed);
+    });
+}
+
+/// `backward_impl` 呼び出し 1 回（1 step 相当）の終わりに、累積した
+/// カテゴリ別カウンタと `total_ns`（`backward_impl` 全体の壁時計時間）を
+/// 1 行の機械可読な形式で stderr へ出力し、カウンタをリセットする。
+pub(crate) fn report_backward(total_ns: u64) {
+    if !is_enabled() {
+        return;
+    }
+    let seq = SEQ.fetch_add(1, Ordering::Relaxed);
+    COUNTERS.with(|c| {
+        eprintln!(
+            "DIAG_BACKWARD seq={} total_ns={} vjp_ns={} gemm_ns={} fill_ns={} mask_ns={} \
+             ewise_ns={} transpose_ns={} materialize_ns={} accumulate_ns={} loss_ns={} \
+             vjp_calls={} gemm_calls={} mask_calls={}",
+            seq,
+            total_ns,
+            c.vjp_ns.get(),
+            c.gemm_ns.get(),
+            c.fill_ns.get(),
+            c.mask_ns.get(),
+            c.ewise_ns.get(),
+            c.transpose_ns.get(),
+            c.materialize_ns.get(),
+            c.accumulate_ns.get(),
+            c.loss_ns.get(),
+            c.vjp_calls.get(),
+            c.gemm_calls.get(),
+            c.mask_calls.get(),
+        );
+        c.vjp_ns.set(0);
+        c.gemm_ns.set(0);
+        c.fill_ns.set(0);
+        c.mask_ns.set(0);
+        c.ewise_ns.set(0);
+        c.transpose_ns.set(0);
+        c.materialize_ns.set(0);
+        c.accumulate_ns.set(0);
+        c.loss_ns.set(0);
+        c.vjp_calls.set(0);
+        c.gemm_calls.set(0);
+        c.mask_calls.set(0);
+    });
+}
