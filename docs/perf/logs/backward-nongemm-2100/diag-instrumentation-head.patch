+        let mut dense_vec_contig_ns = Vec::with_capacity(ITERS);
+        for _ in 0..ITERS {
+            let start = Instant::now();
+            let r = dense_vec(&g_contig);
+            dense_vec_contig_ns.push(start.elapsed().as_nanos());
+            std::hint::black_box(&r);
+        }
+        let mut dense_vec_transposed_ns = Vec::with_capacity(ITERS);
+        for _ in 0..ITERS {
+            let start = Instant::now();
+            let r = dense_vec(&g_transposed);
+            dense_vec_transposed_ns.push(start.elapsed().as_nanos());
+            std::hint::black_box(&r);
+        }
