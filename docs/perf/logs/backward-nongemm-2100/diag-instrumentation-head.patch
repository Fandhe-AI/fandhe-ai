+
+        eprintln!(
+            "[diag] mse_loss_backward_f32 direct (par_iter_mut, dpred 事前確保) median = {} ns",
+            median(direct_ns)
+        );
+        eprintln!(
+            "[diag] naive sequential for-loop median = {} ns",
+            median(naive_ns)
+        );
+    }
+}
