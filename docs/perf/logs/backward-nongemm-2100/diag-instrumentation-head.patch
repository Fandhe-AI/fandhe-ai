+//! 一時的な機構診断ベンチ（恒久実装ではない。ユーザー依頼「学習 1 step
+//! backward の `CpuBackendOps::mse_loss_backward` が 640 要素に対し約
+//! 70 µs かかる固定費の機構を確定する」の一環）。
+//!
+//! `mse.rs::diag_backward_bench`（クレート内 `#[cfg(test)]`）が
+//! `mse_loss_backward_f32` 単体（(a)）と単純逐次ループ（(b)）を計測する
+//! のに対し、本ファイルは公開 API `CpuBackendOps::mse_loss_backward`
+//! （`vec![0.0f32; n]` 確保・`Tensor::new` 構築を含む全体。(c)）を
+//! 計測し、(a) との差分から確保・構築コストの寄与を切り分ける。
+//!
+//! `#[ignore]` 付き（参考用・判定外）。`cargo test -p fandhe-ai-backend-cpu
+//! --release --test mse_backward_fixed_cost_diag -- --ignored --nocapture`
+//! で実行し中央値（ns）を stderr へ出力する。
+
+use fandhe_ai_backend_cpu::CpuBackendOps;
+use fandhe_ai_tensor_core::{BackendOps, Tensor};
+use std::time::Instant;
+
+const ITERS: usize = 1000;
+const N: usize = 640;
+
+fn median(mut v: Vec<u128>) -> u128 {
+    v.sort_unstable();
+    v[v.len() / 2]
+}
+
+#[test]
+#[ignore = "診断専用マイクロベンチ（イシュー #2100 では判定に使わない参考用。実行は --ignored --nocapture）"]
+fn bench_cpu_backend_ops_mse_loss_backward_full_path() {
+    let pred_data: Vec<f32> = (0..N).map(|i| (i as f32) * 0.01 - 3.0).collect();
+    let target_data: Vec<f32> = (0..N).map(|i| (i as f32) * 0.005 - 1.0).collect();
+    let pred = Tensor::new(pred_data, &[N]).unwrap();
+    let target = Tensor::new(target_data, &[N]).unwrap();
+    let ops = CpuBackendOps::new();
+    let scale = 1.0f32 / (N as f32);
+
+    // ウォームアップ。
+    for _ in 0..50 {
+        let r = ops.mse_loss_backward(&pred, &target, scale).unwrap();
+        std::hint::black_box(&r);
+    }
+
+    let mut full_ns = Vec::with_capacity(ITERS);
+    for _ in 0..ITERS {
+        let start = Instant::now();
+        let r = ops.mse_loss_backward(&pred, &target, scale).unwrap();
+        full_ns.push(start.elapsed().as_nanos());
+        std::hint::black_box(&r);
+    }
+
+    // (c) の内訳切り分け用: `pred.contiguous()`／`target.contiguous()`
+    // 単体（両者とも入力は既に contiguous なので `Arc::clone` のみの
+    // はずだが実測で確認する）。
+    let mut contiguous_ns = Vec::with_capacity(ITERS);
+    for _ in 0..ITERS {
+        let start = Instant::now();
+        let pc = pred.contiguous();
+        let tc = target.contiguous();
+        contiguous_ns.push(start.elapsed().as_nanos());
+        std::hint::black_box((&pc, &tc));
+    }
+
+    // `vec![0.0f32; N]` 確保単体。
+    let mut alloc_ns = Vec::with_capacity(ITERS);
+    for _ in 0..ITERS {
+        let start = Instant::now();
+        let v = vec![0.0f32; N];
+        alloc_ns.push(start.elapsed().as_nanos());
+        std::hint::black_box(&v);
+    }
+
+    // `Tensor::new(vec, shape)` 構築単体（データは事前確保済みを渡す）。
+    let mut tensor_new_ns = Vec::with_capacity(ITERS);
+    for _ in 0..ITERS {
+        let data = vec![0.0f32; N];
+        let start = Instant::now();
+        let t = Tensor::new(data, &[N]).unwrap();
+        tensor_new_ns.push(start.elapsed().as_nanos());
+        std::hint::black_box(&t);
+    }
+
+    eprintln!(
+        "[diag] CpuBackendOps::mse_loss_backward full path median = {} ns",
+        median(full_ns)
+    );
+    eprintln!(
+        "[diag] pred.contiguous()+target.contiguous() median = {} ns",
+        median(contiguous_ns)
+    );
+    eprintln!(
+        "[diag] vec![0.0f32; {N}] alloc median = {} ns",
+        median(alloc_ns)
+    );
+    eprintln!(
+        "[diag] Tensor::new(vec, shape) construct median = {} ns",
+        median(tensor_new_ns)
+    );
+}
